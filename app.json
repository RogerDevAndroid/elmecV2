{
  "expo": {
    "name": "ElmecV2",
    "slug": "elmecv2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elmecv2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Sistema de atención al cliente y soporte técnico ELMEC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elmec.elmecv2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.elmec.elmecv2"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50e7df84-dc32-4b11-9a78-29ff4b72e7a2"
      }
    },
    "owner": "rogermck"
  }
}
